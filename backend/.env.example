# Razorpay Test Mode
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Production database (Render PostgreSQL connection string)
# The backend automatically converts postgres:// or postgresql:// to asyncpg.
DATABASE_URL=postgresql://user:password@host:5432/recoverops

# OpenAI (optional; used for LLM dunning messages)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Browser CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-project.vercel.app

# Policy Config
MAX_RETRIES_PER_PAYMENT=3
MAX_CONTACT_ATTEMPTS=5
DND_START_HOUR=21
DND_END_HOUR=9
COST_CAP_PERCENTAGE=15
MIN_CONFIDENCE_THRESHOLD=0.65
